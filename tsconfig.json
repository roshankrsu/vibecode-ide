{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "vibecode-starters",
    "vibecode-starters/**/node_modules",
    "vibecode-starters/**/.next",
    "vibecode-starters/**/dist",
    "vibecode-starters/**/build",
    "vibecode-starters/**/*.config.ts",
    "vibecode-starters/**/*.config.js",
    "vibecode-starters/**/*.config.mts",
    "vibecode-starters/**/*.config.mjs",
    "vibecode-starters/**/vitest.config.ts"
  ]
}
